# Build context is app/ (both Compose files); COPY . . must not copy local state.
**/node_modules
**/.git
**/.env
**/.env.*
**/.data
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.core
**/*.pem
**/*.key
**/secrets
**/credentials.json
test
# The agent package stays out. The server needs only its package.json, for the published version;
# everything else it shares with the agent lives in shared/.
agent/*
!agent/package.json
